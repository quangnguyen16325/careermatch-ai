NODE_ENV=development
WEB_PORT=5173
API_PORT=3000
AI_SERVICE_PORT=8001
POSTGRES_DB=careermatch
# Host-only published ports; containers use their service names and internal ports.
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_USER=careermatch
POSTGRES_PASSWORD=careermatch_local
DATABASE_URL=postgresql://careermatch:careermatch_local@localhost:5432/careermatch?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=careermatch-api
JWT_AUDIENCE=careermatch-web
# Local HTTP only; use true for HTTPS production deployments.
AUTH_COOKIE_SECURE=false
AI_SERVICE_URL=http://localhost:8001
VITE_API_URL=http://localhost:3000/api/v1
LLM_PROVIDER=mock
LLM_API_KEY=
CV_STORAGE_PATH=.data/cvs
# Local email capture: http://localhost:8025 (docker compose up includes Mailpit).
MAIL_MODE=local
SMTP_HOST=localhost
# Container hostname is independent of the host development SMTP address.
SMTP_DOCKER_HOST=mailpit
SMTP_PORT=1025
SMTP_LOCAL_PORT=1025
MAILPIT_PORT=8025
SMTP_FROM=CareerMatch AI <noreply@careermatch.local>
SMTP_USER=
SMTP_PASSWORD=
AUTH_PUBLIC_WEB_URL=http://localhost:5173
AUTH_VERIFY_TTL=24h
AUTH_RESET_TTL=30m
# Optional container database URL override for URI-encoded credentials.
# DOCKER_DATABASE_URL=postgresql://careermatch:careermatch_local@postgres:5432/careermatch?schema=public
